<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="TickerBackgroundBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="TickerBorderBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#555555"/>
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#F7F7F7"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FAFFFFFF"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#D0D0D0"/>

    <DropShadowEffect x:Key="TickerShadow"
                      Color="#60000000"
                      BlurRadius="10"
                      ShadowDepth="2"
                      Opacity="0.35"/>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
</ResourceDictionary>
