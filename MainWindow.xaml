<Window x:Class="SatoshiTicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satoshi Ticker"
        Width="300"
        Height="46"
        MinWidth="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#F21B1B1B"
            BorderBrush="#555555"
            BorderThickness="1"
            CornerRadius="9"
            Padding="12,6">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="BTC-Bestand ändern" Click="ChangeBitcoinAmount_Click"/>
                <MenuItem Header="Jetzt aktualisieren" Click="RefreshNow_Click"/>
                <Separator/>
                <MenuItem x:Name="AutoStartMenuItem"
                          Header="Mit Windows starten"
                          IsCheckable="True"
                          Click="AutoStart_Click"/>
                <Separator/>
                <MenuItem Header="Beenden" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="₿"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#F7931A"
                       VerticalAlignment="Center"
                       Margin="0,0,9,0"/>

            <TextBlock x:Name="PortfolioValueText"
                       Grid.Column="1"
                       Text="Lade Kurs …"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <TextBlock x:Name="TrendArrowText"
                           Text="•"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#B0B0B0"/>
                <TextBlock x:Name="TrendPercentText"
                           Text=" 0,00 %"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
