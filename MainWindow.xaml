<Window x:Class="SatoshiTicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Satoshi Ticker"
        Height="46"
        SizeToContent="Width"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        ToolTipOpening="Window_ToolTipOpening"
        ToolTipClosing="Window_ToolTipClosing"
        LocationChanged="Window_LocationChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource TickerBackgroundBrush}"
            BorderBrush="{DynamicResource TickerBorderBrush}"
            BorderThickness="1"
            CornerRadius="9"
            Padding="12,6"
            Effect="{DynamicResource TickerShadow}">
        <Border.ContextMenu>
            <ContextMenu Opened="ContextMenu_Opened"
                         Closed="ContextMenu_Closed">
                <MenuItem Header="BTC-Bestand ändern" Click="ChangeBitcoinAmount_Click"/>
                <MenuItem Header="Jetzt aktualisieren" Click="RefreshNow_Click"/>
                <Separator/>
                <MenuItem x:Name="AutoStartMenuItem"
                          Header="Mit Windows starten"
                          IsCheckable="True"
                          Click="AutoStart_Click"/>
                <Separator/>
                <MenuItem x:Name="AppearanceMenuItem"
                          Header="Darstellung">
                    <MenuItem Header="Dark Mode"
                              IsCheckable="True"
                              Click="DarkMode_Click"/>
                    <MenuItem Header="Light Mode"
                              IsCheckable="True"
                              Click="LightMode_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Beenden" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="₿"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="{DynamicResource BitcoinAccentBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,9,0"/>

            <TextBlock x:Name="PortfolioValueText"
                       Grid.Column="1"
                       Text="Lade Kurs …"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <TextBlock x:Name="TrendArrowText"
                           Text="•"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#B0B0B0"/>
                <TextBlock x:Name="TrendPercentText"
                           Text=" 0,00 %"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#B0B0B0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
